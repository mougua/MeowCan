# MySQL：本地开发通过 SSH 隧道连接 dev135。
# ssh -N -L 3307:127.0.0.1:3307 dev135
DATABASE_URL=mysql://meowcan:replace-me@127.0.0.1:3307/meowcan

# SQLite：取消下一行注释，并注释 MySQL 的 DATABASE_URL。
# 数据库必须位于后端本机的本地磁盘，禁止放在 NFS、SMB 等网络文件系统上。
# DATABASE_URL=sqlite://data/meowcan.db?mode=rwc

# 默认值：MySQL 为 5，SQLite 为 4。低内存环境一般无需修改。
# MEOWCAN_DATABASE_MAX_CONNECTIONS=4
MEOWCAN_BIND=127.0.0.1:8080
MEOWCAN_COOKIE_SECURE=false
MEOWCAN_SESSION_HOURS=168
RUST_LOG=meowcan_server=info,tower_http=info
